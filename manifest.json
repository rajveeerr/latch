{
  "manifest_version": 3,
  "name": "Latch",
  "version": "0.3.0",
  "description": "Lock this browser profile behind a passcode. Covers pages, hides windows and pauses media. Never closes or changes your tabs.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Latch",
    "default_popup": "ui/popup.html"
  },
  "options_page": "ui/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "idle",
    "alarms",
    "scripting",
    "sessions"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/cover.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "lock-now": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "MacCtrl+Shift+L"
      },
      "description": "Lock this profile now"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
